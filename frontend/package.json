    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
