# Copy to backend/.env and fill in. Never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Supabase (Dashboard -> Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
LLM_TIMEOUT_SECONDS=60
DEFAULT_JUDGE_MODEL=gpt-4o

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_TTL_SECONDS=3600

# Plan limits (evaluations per month, -1 = unlimited)
FREE_EVAL_LIMIT=100
PRO_EVAL_LIMIT=10000
ENTERPRISE_EVAL_LIMIT=-1

# Optional
SENTRY_DSN=
